# Nikdy sem nevkladejte skutecna hesla. Produkcni hodnoty patri do Render Environment.

# SSH tunnel
SSH_ENABLED=true
SSH_HOST=ssh.example.com
SSH_PORT=22
SSH_USER=replace-me
SSH_PASSWORD=replace-me
# Bezpecnejsi alternativa k heslu:
# SSH_PRIVATE_KEY_FILE=/etc/secrets/ssh_private_key
# SSH_PRIVATE_KEY_PASSPHRASE=replace-me
SSH_REMOTE_DB_HOST=127.0.0.1
SSH_REMOTE_DB_PORT=3306
SSH_LOCAL_PORT=3306
SSH_CONNECT_TIMEOUT_MS=10000
SSH_CONNECT_ATTEMPTS=6
SSH_RECONNECT_INTERVAL_MS=15000
SSH_STRICT_HOST_KEY_CHECKING=yes
SSH_KNOWN_HOSTS_FILE=/etc/secrets/ssh_known_hosts

# Database
DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/database_name?serverTimezone=UTC
DATASOURCE_USER=replace-me
DATASOURCE_PASSWORD=replace-me
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
JPA_DDL_AUTO=validate

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me

# Application
PORT=8080
REMEMBER_ME_KEY=generate-at-least-32-random-bytes
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=JSESSIONID
SESSION_COOKIE_SAME_SITE=lax
APPLICATION_LOG_LEVEL=INFO
